{
  "family": "fargate_service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/fargate_service-execution-role",
  "taskRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/fargate_service-task-role",
  "containerDefinitions": [
    {
      "name": "fargate_service",
      "image": "__ACCOUNT_ID__.dkr.ecr.us-east-2.amazonaws.com/fargate_service:latest-main",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "EXAMPLE_VAR",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:__ACCOUNT_ID__:secret:prod/fargate_service:EXAMPLE_VAR::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fargate_service",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
